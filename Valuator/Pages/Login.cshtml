@page
@model Valuator.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<h1>@ViewData["Title"]</h1>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="mt-3" style="max-width: 400px;">
    <div class="mb-3">
        <label for="login" class="form-label">Логин</label>
        <input id="login" name="Login" class="form-control" value="@Model.Login" autocomplete="username" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Пароль</label>
        <input id="password" name="Password" type="password" class="form-control" autocomplete="current-password" />
    </div>
    <button type="submit" class="btn btn-primary">Войти</button>
    <a asp-page="/Register" class="ms-2">Регистрация</a>
</form>
