<mxfile host="app.diagrams.net"><diagram id="c4-containers" name="C4 Containers"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;C4. Диаграмма контейнеров: система Valuator (PA6, сегментирование БД)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="boundary" value="Система Valuator" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#444444;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="50" width="1000" height="1030" as="geometry"/></mxCell><mxCell id="shards" value="Сегменты данных (ShardKey = регион страны)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F9FD;strokeColor=#3C7FC0;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="690" width="330" height="370" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Пользователь&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Вводит текст, выбирает страну и смотрит результат оценки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=8;strokeColor=#052E56;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="170" height="110" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Браузер&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Web Browser]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Отправляет формы, показывает страницы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="170" height="90" as="geometry"/></mxCell><mxCell id="nginx" value="&lt;b&gt;Nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Reverse proxy, :8080]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Обратный прокси и балансировщик нагрузки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="270" y="330" width="190" height="110" as="geometry"/></mxCell><mxCell id="valuator" value="&lt;b&gt;Valuator (×N)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[ASP.NET Core, :5001, :5002…]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Принимает текст и страну, определяет сегмент, считает похожесть, ставит задание на оценку&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="530" y="330" width="200" height="120" as="geometry"/></mxCell><mxCell id="nats" value="&lt;b&gt;NATS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Брокер сообщений, :4222]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Задания: valuator.processing.rank&lt;br&gt;События: events.*.calculated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="950" y="330" width="220" height="120" as="geometry"/></mxCell><mxCell id="rank" value="&lt;b&gt;RankCalculator (×N)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[.NET, фоновый процесс]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Находит сегмент по id, вычисляет оценку текста&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="950" y="520" width="220" height="110" as="geometry"/></mxCell><mxCell id="logger" value="&lt;b&gt;EventsLogger (×2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[.NET, консольное приложение]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Подписчики: выводят в консоль события RankCalculated и SimilarityCalculated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;arcSize=8;" vertex="1" parent="1"><mxGeometry x="950" y="100" width="220" height="110" as="geometry"/></mxCell><mxCell id="main" value="&lt;b&gt;DB_MAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Redis, :6000]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Shard map: SHARD-id → ShardKey&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="200" height="120" as="geometry"/></mxCell><mxCell id="ru" value="&lt;b&gt;DB_RU (регион RU)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Redis, :6001]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Russia&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="900" y="730" width="290" height="90" as="geometry"/></mxCell><mxCell id="eu" value="&lt;b&gt;DB_EU (регион EU)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Redis, :6002]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;France, Germany&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="900" y="840" width="290" height="90" as="geometry"/></mxCell><mxCell id="asia" value="&lt;b&gt;DB_ASIA (регион ASIA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Redis, :6003]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;UAE, India&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="900" y="950" width="290" height="90" as="geometry"/></mxCell><mxCell id="e0" value="Использует" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Запросы страниц&lt;br&gt;[HTTP, :8080]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="nginx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Проксирует запросы,&lt;br&gt;балансировка&lt;br&gt;[HTTP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nginx" target="valuator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Задание на оценку (id)&lt;br&gt;[NATS, publish]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="valuator" target="nats"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3b" value="Событие SimilarityCalculated&lt;br&gt;[NATS, pub/sub]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="valuator" target="nats"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Задание&lt;br&gt;(одному экземпляру)&lt;br&gt;[queue group]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="nats" target="rank"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4b" value="Событие&lt;br&gt;RankCalculated&lt;br&gt;[pub/sub]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="rank" target="nats"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="События RankCalculated и SimilarityCalculated&lt;br&gt;(каждому экземпляру)&lt;br&gt;[NATS, pub/sub]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nats" target="logger"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Пишет и читает карту сегментов&lt;br&gt;(SHARD-id)&lt;br&gt;[TCP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="valuator" target="main"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Данные текста: TEXT-, COUNTRY-,&lt;br&gt;SIMILARITY-, RANK- (сегмент по ShardKey)&lt;br&gt;[TCP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="valuator" target="shards"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Находит сегмент по id&lt;br&gt;[TCP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="rank" target="main"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="Читает TEXT-id,&lt;br&gt;пишет RANK-id&lt;br&gt;[TCP]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#707070;fontColor=#404040;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="rank" target="shards"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Страница summary показывает «Оценка содержания не завершена», пока RankCalculator не записал RANK-id в сегмент. Компоненты, обращающиеся к БД по id текста, пишут лог LOOKUP: id, ShardKey." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="190" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>